# Copy to apps/collab/.env for local development (never commit .env).
PORT=1234
# Postgres connection string for the least-privilege collab_server role
# (see docs/DEPLOYMENT.md). Use the Supabase *session* pooler or direct URL.
COLLAB_DATABASE_URL=postgresql://collab_server.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Must equal COLLAB_JWT_SECRET in the web app. Generate: openssl rand -hex 32
COLLAB_JWT_SECRET=replace-with-at-least-32-random-characters
# Comma-separated origins allowed to connect (your web app URL).
COLLAB_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info
