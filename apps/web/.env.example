# Copy to apps/web/.env.local for local development. Never commit real values.

# Supabase → Project Settings → API. The publishable (or legacy anon) key is
# browser-safe; access is enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Public URL of this app (used in email links and invitation links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WebSocket URL of the collaboration server (apps/collab). Use wss:// in production.
NEXT_PUBLIC_COLLAB_URL=ws://localhost:1234

# Server-only. Must equal COLLAB_JWT_SECRET in apps/collab. Generate: openssl rand -hex 32
COLLAB_JWT_SECRET=replace-with-at-least-32-random-characters

# Optional: set to "true" only after configuring the Google provider in Supabase.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# Server-only, optional: send workspace invitations by email. Use the same SMTP
# account as Supabase Auth (Authentication → Emails → SMTP Settings).
# Port 465 = TLS, 587 = STARTTLS. Without these, invites are copyable links.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CollabVerse <no-reply@yourdomain.com>"
